{
  "schema": 1,
  "steps": [
    {
      "type": "wait_phase",
      "phase": "in_game",
      "timeout_frames": 2400
    },
    {
      "type": "press",
      "action": "toggle_inventory"
    },
    {
      "type": "wait_frames",
      "frames": 1
    },
    {
      "type": "assert",
      "condition": "inventory_open",
      "equals": true
    },
    {
      "type": "release",
      "action": "toggle_inventory"
    },
    {
      "type": "wait_frames",
      "frames": 1
    },
    {
      "type": "press",
      "action": "toggle_inventory"
    },
    {
      "type": "wait_frames",
      "frames": 1
    },
    {
      "type": "assert",
      "condition": "inventory_open",
      "equals": false
    },
    {
      "type": "release",
      "action": "toggle_inventory"
    },
    {
      "type": "wait_frames",
      "frames": 90
    },
    {
      "type": "exit"
    }
  ]
}
